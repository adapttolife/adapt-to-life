{
  "name": "adapt-to-life",
  "version": "1.0.0",
  "description": "Marketing site for **Adapt To Life — Your Place in Adaptive Sports**, deployed on Cloudflare Workers. Serves a static site plus one form-capture API route.",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "node --test",
    "cards": "node scripts/make-og.mjs && node scripts/wire-og.mjs",
    "volunteer": "node scripts/build-volunteer.mjs",
    "stamp": "node scripts/stamp-build.mjs",
    "preview": "ATL_TARGET=staging npx wrangler versions upload --env staging",
    "deploy:staging": "ATL_TARGET=staging npx wrangler deploy --env staging",
    "deploy:prod": "npx wrangler deploy",
    "deploy:reports": "npx wrangler deploy --config wrangler.reports.jsonc",
    "deploy:agent-mail": "npx wrangler deploy --config wrangler.agent-mail.jsonc",
    "check": "node scripts/check-site.mjs",
    "build:app": "vite build && node scripts/check-bundle-budget.mjs",
    "typecheck": "tsc --noEmit",
    "dev:app": "vite",
    "photos": "${SITE_PY:-/home/agentos/.venvs/vectorize/bin/python} scripts/build-hero-panels.py && node scripts/apply-hero.mjs 1 && node scripts/apply-page-headers.mjs && node scripts/build-volunteer.mjs && node scripts/build-hero-lab.mjs && npm run stamp",
    "css": "node scripts/build-css.mjs",
    "asnm": "node scripts/build-asnm.mjs",
    "asnm:shot": "node scripts/shoot-asnm.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coldcrippy/adapt-to-life.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/coldcrippy/adapt-to-life/issues"
  },
  "homepage": "https://github.com/coldcrippy/adapt-to-life#readme",
  "dependencies": {
    "@resvg/resvg-wasm": "^2.6.2",
    "pdf-lib": "^1.17.1",
    "postal-mime": "^2.7.5",
    "satori": "^0.28.0"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "d3-geo": "^3.1.1",
    "playwright": "1.55.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "topojson-client": "^3.1.0",
    "topojson-simplify": "^3.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "wrangler": "4.130.0"
  }
}
