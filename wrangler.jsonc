{
  // Cloudflare Worker for Adapt To Life.
  // Serves the static site from ./public and handles POST /api/contact and
  // POST /api/apply in src/index.js, writing both to ClickUp. Production is
  // published only on the three custom domains below; review builds use the
  // separate staging environment.
  "name": "adapt-to-life",
  "compatibility_date": "2026-06-24",
  "main": "src/index.js",

  // Stamps public/build.txt (commit + digest of every deployed file) before ANY
  // wrangler deploy, versions upload, or dev. It lives here rather than only in
  // an npm script because a second session deployed production with bare
  // `wrangler deploy` 19 seconds after ours on 2026-07-25 and the stamp went
  // missing, which is exactly the case the stamp exists to detect. A control
  // that a human has to remember to invoke is not a control.
  // Mission Control is built BEFORE the stamp, because the stamp hashes every
  // file in public/ — stamping first would fingerprint a build that does not
  // exist yet and quietly certify the wrong bytes. The budget check is part of
  // the build command, not a separate step someone can forget.
  // build-css runs BEFORE the stamp, because the stamp digests every file in
  // public/ and stamping first would fingerprint stylesheets that do not exist
  // yet. Same ordering reason as Mission Control above.
  // guard-prod-branch runs FIRST and refuses a production deploy that is not
  // main, clean and pushed. It is in the build hook, not the deploy:prod npm
  // script, for the same reason the stamp is: a bare `wrangler deploy` has to
  // hit it. It cannot read the target from wrangler — MEASURED 2026-09-10, the
  // build command receives only CLOUDFLARE_* and WRANGLER_COMMAND=deploy, which
  // are identical for prod and `--env staging` — so the STAGING scripts opt out
  // by exporting ATL_TARGET=staging and anything else is treated as production.
  // That is the fail-closed direction: an unrecognised invocation is guarded.
  // build-asnm pulls the live directory counts onto /adaptive-sports-near-me
  // and the homepage. It runs BEFORE the stamp like everything else that writes
  // into public/, and it cannot fail the build: if the directory's API is
  // unreachable it reuses the committed data/asnm-stats.json and says so.
  "build": { "command": "node scripts/guard-prod-branch.mjs && npm run build:app && node scripts/build-css.mjs && npm test && node scripts/build-asnm.mjs && node scripts/stamp-build.mjs" },

  // Live custom domains (apex + www). Cloudflare manages DNS + TLS for these.
  "routes": [
    { "pattern": "adapttolife.org", "custom_domain": true },
    { "pattern": "www.adapttolife.org", "custom_domain": true },
    { "pattern": "sign.adapttolife.org", "custom_domain": true }
  ],
  // No alternate production ingress. The production Worker also carries
  // authenticated operational APIs and data bindings; workers.dev or version
  // previews would expose the same bundle outside the intended custom-domain
  // boundary. The separate, front-end-only staging environment below keeps
  // its workers.dev and per-version review URLs.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // /review is staging-only: run the Worker first for it so the redirect gate
    // executes (assets otherwise serve before the Worker and bypass the gate).
    // /admin/* is the same shape for the opposite reason: it is PRODUCTION-only.
    // Cloudflare Access protects adapttolife.org/admin, but Access is bound to a
    // hostname and the staging Worker answers on workers.dev, where no Access
    // app exists — so without the Worker running first, the QR admin page would
    // serve to anyone who guessed the staging URL.
    "run_worker_first": ["/review", "/review.html", "/photo-picks", "/photo-picks.html",
      "/hero-review", "/hero-review.html", "/hero-1", "/hero-1.html", "/hero-2", "/hero-2.html", "/hero-3", "/hero-3.html",
        "/hero-4", "/hero-4.html", "/hero-5", "/hero-5.html", "/hero-6", "/hero-6.html", "/hero-7", "/hero-7.html", "/hero-9", "/hero-9.html",
      "/admin/*"]
  },
  "observability": {
    "enabled": true
  },
  // Spec 70 P2: the PNG chart pipeline (src/chart_assets_worker.js) imports the
  // bundled Inter TTFs as raw bytes. .wasm needs no rule — wrangler's default
  // CompiledWasm rule covers satori/yoga.wasm and @resvg/resvg-wasm/index_bg.wasm.
  "rules": [
    { "type": "Data", "globs": ["**/*.ttf"], "fallthrough": true }
  ],
  "vars": {
    "ENV_NAME": "production",
    "INTAKE_INBOX": "hello@adapttolife.org",
    // Non-secret config. Both public forms write to ClickUp, which is the tracker
    // ATL actually reviews from; nothing writes to Airtable any more. Lists live in
    // Team Space -> Adapt To Life. The token is a secret:
    //   cfrun wrangler secret put CLICKUP_TOKEN
    "BEEHIIV_PUBLICATION_ID": "pub_d1bfe66c-074f-464a-a94a-d0cce6d21943",
    "CLICKUP_APPLICATIONS_LIST_ID": "901418622126",
    "CLICKUP_CONTACTS_LIST_ID": "901418639884",
    "CLICKUP_VOLUNTEERS_LIST_ID": "901419920230",
    // Human action layer for donors, vendors, organizations, partners,
    // sponsorships, and grants ATL is pursuing. D1 remains source of truth.
    "CLICKUP_RELATIONSHIPS_LIST_ID": "901418931939",
    // Google Shared Drive ("Adapt To Life") for the signed-release archive.
    // The service account JSON is a secret: cfrun wrangler secret put GOOGLE_SA_JSON
    // That SAME credential also mirrors Adapt Body Shop contact-form messages
    // into the "Adapt To Life CRM" sheet ("Shop Messages" tab). That sheet is in
    // Alec's PERSONAL Drive and the service account reaches it only because the
    // file is shared with it as an editor — Shared Drive membership buys nothing
    // there. See src/google.js.
    "WAIVERS_DRIVE_ID": "1NAW-FAeJKJnGgmMgzgRGS78CxE5WYo-p",
    // POST /api/shop-contact is the Adapt Body Shop storefront's contact form
    // (a separate Worker with no database and no mail binding). The shared
    // secret both Workers hold is SHOP_CONTACT_KEY, a secret and never a var:
    //   cfrun wrangler secret put SHOP_CONTACT_KEY
    // It is stored in 1Password as "Adapt Body Shop contact key" (Engineering).
    // Without it this Worker refuses every shop-contact request with a 503,
    // which is the correct failure: an unset key must close the door, not open
    // it. See src/shop_contact.js.
    // Spec 32 agent email. AGENT_MAIL_TOKEN (MCP bearer) is a secret. Outbound mail uses
    // the SEND_EMAIL binding below (Cloudflare Email Sending) — no API key.
    "AGENT_MAIL_DOMAIN": "agents.adapttolife.org",
    // Spec 70 P3: reports live on their own Worker behind Cloudflare Access
    // (wrangler.reports.jsonc). Every NEW report/library link this Worker mints
    // points there; the old adapttolife.org/r/ and /lib/ links already in
    // inboxes are forwarded to the same origin by src/index.js.
    "REPORT_LINK_BASE": "https://reports.amelioration.is",
    // Where the internal copy of a GRANT APPLICATION is bcc'd, and the reply-to
    // on the applicant's receipt. Applications carry disability detail and
    // financial need; hello@ is the public address in every page footer and a
    // shared working seat, so this is deliberately its own setting.
    // TO RESTRICT: create grants@adapttolife.org in Google Workspace, limit its
    // members to the people who actually review grants, then change this one
    // line. No code change. Until that mailbox exists this stays on hello@,
    // because a bcc to an address that does not resolve is worse than a shared
    // one: it would bounce the applicant's own receipt.
    "GRANTS_INBOX": "hello@adapttolife.org",
    // Fundraising thermometer and donor reconciliation. API key is a secret.
    "GIVEBUTTER_CAMPAIGN_ID": "683765",
    // Exact creation time of ATL's donor-journey activation webhook. Scheduled
    // reconciliation must never send retroactive thank-yous for the baseline.
    "GIVEBUTTER_DONOR_CUTOFF": "2026-08-08T22:40:55Z",
    "OFFLINE_RAISED": "3004"
  },
  // Signed-waiver storage: PDFs in R2, the signing record index in D1.
  "r2_buckets": [
    { "binding": "WAIVERS_BUCKET", "bucket_name": "atl-waivers" },
    // Spec 32 agent email: raw .eml + attachments.
    { "binding": "AGENT_MAIL_BUCKET", "bucket_name": "agent-mail" }
  ],
  "d1_databases": [
    { "binding": "WAIVERS_DB", "database_name": "atl-waivers", "database_id": "d34c2394-57f8-44ca-9089-c4569557dbb1" },
    // Spec 32 agent email: threads/messages/inboxes (source of truth).
    { "binding": "AGENT_MAIL_DB", "database_name": "agent-mail", "database_id": "8609089a-7d9c-4d46-a527-d7f00c5ca050" },
    { "binding": "INTAKE", "database_name": "atl-intake", "database_id": "916e841e-50cc-4661-806a-865cd24fbb53" }
  ],
  // Outbound email via Cloudflare Email Sending (native binding, no API key). Used by
  // src/email.js cfSend for agent replies + waiver receipts. Sender domains
  // (agents.adapttolife.org + the apex) are onboarded to Email Service; no recipient
  // restriction attribute, so the Worker can send to arbitrary recipients (Workers Paid).
  "send_email": [
    { "name": "SEND_EMAIL" }
  ],
  // Compliance archive runs every 10 minutes: push new signed releases to Drive.
  // Per-network form rate limit (Workers Rate Limiting binding; src/turnstile.js
  // overFormLimit): 6 form POSTs / 60 s per connecting IP on every /api form
  // route. The zone rule (100 req / 10 s) only stops floods. Bindings are not
  // inherited by environments, so staging declares the same one.
  "ratelimits": [
    { "name": "FORM_LIMITER", "namespace_id": "1001", "simple": { "limit": 6, "period": 60 } }
  ],
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  // Staging preview: a separate Worker (adapt-to-life-staging) on workers.dev for
  // design review before promoting to production. Front-end only — no data bindings
  // and no cron — so staging can never touch prod ClickUp / D1 / R2 / email.
  "env": {
    "staging": {
      "name": "adapt-to-life-staging",
      "main": "src/staging.js",
      "workers_dev": true,
      "preview_urls": false,
      "vars": { "STAGING": "1" },
      "routes": [],
      // Every route crosses the review-only entrypoint, including assets.
      // HTML rewrites disable payment widgets and forms without changing prod.
      "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
      "d1_databases": [],
      "r2_buckets": [],
      "send_email": [],
      "ratelimits": [{ "name": "FORM_LIMITER", "namespace_id": "1001", "simple": { "limit": 6, "period": 60 } }],
      "triggers": { "crons": [] }
    }
  }
}
