{
  // Cloudflare Worker for Adapt To Life.
  // Serves the static site from ./public and handles POST /api/contact in src/index.js,
  // writing leads to Airtable. Published to the `adapt-to-life` Worker at
  // https://adapt-to-life.alec-af3.workers.dev
  "name": "adapt-to-life",
  "compatibility_date": "2026-06-24",
  "main": "src/index.js",
  // Live custom domains (apex + www). Cloudflare manages DNS + TLS for these.
  "routes": [
    { "pattern": "adapttolife.org", "custom_domain": true },
    { "pattern": "www.adapttolife.org", "custom_domain": true },
    { "pattern": "sign.adapttolife.org", "custom_domain": true }
  ],
  // Keep the workers.dev URL + version preview URLs for staging / A-B work.
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    // Non-secret config. The Airtable token is set separately as a secret:
    //   cfrun wrangler secret put AIRTABLE_TOKEN
    "AIRTABLE_BASE_ID": "appVPKDdwnOG5qkYG",
    "AIRTABLE_TABLE_ID": "tblhJaZtMY37K7Uio",
    "AIRTABLE_APPLICATIONS_TABLE_ID": "tbl1Aiy8CId6hIzF6",
    // Compliance mirror: signed releases land in the Airtable "Waivers" table.
    "AIRTABLE_WAIVERS_TABLE_ID": "tbl51GcteN2lAbyN9",
    // Google Shared Drive ("Adapt To Life") for the signed-release archive.
    // The service account JSON is a secret: cfrun wrangler secret put GOOGLE_SA_JSON
    "WAIVERS_DRIVE_ID": "0AIG-pWrds0g7Uk9PVA",
    // Spec 32 agent email. RESEND_API_KEY + AGENT_MAIL_TOKEN (MCP bearer) are secrets.
    // AIRTABLE_AGENT_MAIL_TABLE_ID is set once the "Agent Mail" table exists (T04).
    "AGENT_MAIL_DOMAIN": "agents.adapttolife.org"
  },
  // Signed-waiver storage: PDFs in R2, the signing record index in D1.
  "r2_buckets": [
    { "binding": "WAIVERS_BUCKET", "bucket_name": "atl-waivers" },
    // Spec 32 agent email: raw .eml + attachments.
    { "binding": "AGENT_MAIL_BUCKET", "bucket_name": "agent-mail" }
  ],
  "d1_databases": [
    { "binding": "WAIVERS_DB", "database_name": "atl-waivers", "database_id": "d34c2394-57f8-44ca-9089-c4569557dbb1" },
    // Spec 32 agent email: threads/messages/inboxes (source of truth).
    { "binding": "AGENT_MAIL_DB", "database_name": "agent-mail", "database_id": "8609089a-7d9c-4d46-a527-d7f00c5ca050" }
  ],
  // Compliance archive runs every 10 minutes: push new signed releases to Drive.
  "triggers": {
    "crons": ["*/10 * * * *"]
  }
}
